# Copy to .env.local. run.sh loads that file before starting AgentUI.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=consynth-x-boss

# Offline BOSS experiments write orchestration traces to a separate project.
BOSS_EVAL_LANGSMITH_PROJECT=consynth-x-boss-offline
# BOSS_EVAL_CODEX_MODEL=gpt-5.6-terra
# BOSS_EVAL_WORKER_MODE=capture

# Codex Python SDK reuses `codex login`; no OPENAI_API_KEY is required.
# AGENTUI_CODEX_SANDBOX_MODE=workspace-write
# AGENTUI_CODEX_APPROVAL_POLICY=never

# Optional privacy controls. Enable either one to suppress that payload class.
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true
