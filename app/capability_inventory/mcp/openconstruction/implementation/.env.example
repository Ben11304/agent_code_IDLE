OPENCONSTRUCTION_DATA_BASE_URL=https://raw.githubusercontent.com/Ben11304/OC-clone/main/open-construction-data
OPENCONSTRUCTION_SITE_BASE_URL=https://www.openconstruction.org
CATALOG_CACHE_TTL_SECONDS=600

# Related papers are included with dataset downloads by default. OC hosts the
# paper manifest and binary source separately from the public website UI.
OC_INCLUDE_PAPERS_DEFAULT=true
OC_PAPER_MANIFEST_URL=https://raw.githubusercontent.com/Ben11304/OC-clone/main/open-construction-data/papers/manifest.json
# GitHub's media endpoint resolves the Git LFS pointers to the actual PDFs.
OC_PAPER_CONTENT_BASE_URL=https://media.githubusercontent.com/media/Ben11304/OC-clone/main/open-construction-data
PAPER_CATALOG_CACHE_TTL_SECONDS=600

# Local stdio dataset downloads. destination tool arguments are directory names
# relative to this root; absolute paths and parent traversal are rejected.
OC_HOME=~/.openconstruction
OC_DATASETS_DIR=~/.openconstruction/datasets
# Legacy alias, used only when OC_DATASETS_DIR is not set:
# OC_DOWNLOAD_ROOT=~/.openconstruction/datasets
OC_MAX_DOWNLOAD_BYTES=536870912000
# Used only when a Hugging Face dataset requires the user's own access grant.
HF_TOKEN=

# Remote MCP and OAuth broker
OC_PUBLIC_URL=http://127.0.0.1:8000
OC_SITE_URL=http://127.0.0.1:8000
OC_AUTH_DB=.openconstruction/state.db
OC_ENV=development
OC_STATIC_DIR=../site
OC_CORS_ORIGINS=http://127.0.0.1:8000
OC_CONNECTED_ACCOUNTS_ENABLED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OC_TOKEN_ENCRYPTION_KEY=

# Connected Accounts OAuth apps. Register each callback under OC_PUBLIC_URL:
# /api/connections/github/callback
# /api/connections/huggingface/callback
# /api/connections/baidu/callback
OC_GITHUB_CLIENT_ID=
OC_GITHUB_CLIENT_SECRET=
OC_GITHUB_SCOPES="read:user"
OC_HF_CLIENT_ID=
OC_HF_CLIENT_SECRET=
OC_HF_SCOPES="openid profile read-repos gated-repos"
OC_BAIDU_CLIENT_ID=
OC_BAIDU_CLIENT_SECRET=
OC_BAIDU_SCOPES="basic netdisk"
